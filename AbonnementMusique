package tp5;
public class AbonnementMusique extends Abonnement implements Reducible {
protected int nbPlaylists;
protected boolean optionOffline;
protected int Score;
protected double cout;
public AbonnementMusique(String nom,double prixBase,int nbProfils,int nbPlaylists,boolean optionOffline) {

	super(nom,prixBase,nbProfils);
	this.nbPlaylists=nbPlaylists;
	this.optionOffline=optionOffline;

}

@Override
public double CoutMensuel() {
	 cout=30;
	if(optionOffline==true) {
		
		cout  = cout + 15;
    }
return cout;
}

@Override
public int ScoreSatisfaction() {
   int Score=50;
if(nbPlaylists>20) {
	Score=Score+20;
	
}
if(optionOffline) {
	Score=Score+20;
}
if( getnbProfils()>1) {
	Score=Score+100;
}
if(Score>100) {
	Score=100;
}
	return Score ;
}
@Override
public boolean EstEligibleReduction(double pourcentage) {
	if(pourcentage>=30) {
		return false;
	}else{
		return true;
	}}
@Override
	public double AppliquerReduction(double pourcentage) {
        double cout = 30;
		if (EstEligibleReduction(pourcentage)) {
            return cout * (1 - pourcentage / 100);
        }
        return cout;
	}
	@Override
	public void afficher() {
		super.afficher();	
		System.out.println("cout total est:"+CoutMensuel());
		System.out.println("score total est:"+ScoreSatisfaction());
	}
}





